DATABASE_URL=sqlite:///./data/service.sqlite
DATA_DIR=./data

# Main inference provider. Put the real key only in .env; .env is ignored by Git.
AI_PROVIDER=polza
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_IMAGE_BASE_URL=https://polza.ai/api/v2
POLZA_MEDIA_BASE_URL=https://polza.ai/api/v1
POLZA_TEXT_MODEL_QUALITY=qwen/qwen3.8-27b
POLZA_TEXT_MODEL_FAST=qwen/qwen3-vl-8b-instruct
POLZA_IMAGE_MODEL=qwen/image-2
POLZA_RETRY_ATTEMPTS=3
POLZA_RETRY_DELAY_SECONDS=0.5

MODEL_PROFILE=selection
MODEL_MODE=quality
MODEL_TIMEOUT_SECONDS=300
MODEL_IMAGE_MAX_EDGE=896
MODEL_MAX_SOURCE_IMAGES=4
MODEL_MAX_PLANNING_ASSETS=8
MODEL_MAX_PLANNING_CLAIMS=32
MODEL_MAX_PLANNING_CHARS=18000
MODEL_AUDIT_MODE=failures
MODEL_AUDIT_CLAIM_CHARS=320
MODEL_MAX_TOKENS_PLANNING=6500
MODEL_MAX_TOKENS_VISION_AUDIT=1800
MODEL_CACHE=1

T2I_WIDTH=1024
T2I_HEIGHT=576
T2I_IMAGE_COUNT=4
T2I_TIMEOUT_SECONDS=600
T2I_POLL_TIMEOUT_SECONDS=900
T2I_POLL_INTERVAL_SECONDS=3

# Optional compatibility mode: AI_PROVIDER=local.
MODEL_BASE_URL=http://127.0.0.1:8001/v1
MODEL_API_KEY=
MODEL_NAME=
T2I_BASE_URL=http://127.0.0.1:8002/v1
T2I_API_KEY=
T2I_MODEL=Tongyi-MAI/Z-Image-Turbo
LOCAL_MODEL_SEQUENTIAL=1

FONT_FALLBACK=Arial
SOFFICE=soffice
PDFTOPPM=pdftoppm
CORS_ORIGINS=http://localhost:5173
