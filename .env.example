DATABASE_URL=sqlite:///./data/service.sqlite
DATA_DIR=./data
# One Polza key is used for text, vision and image generation.
POLZA_API_KEY=
MODEL_BASE_URL=https://polza.ai/api/v1
# Optional separate key for the text endpoint; otherwise POLZA_API_KEY is used.
MODEL_API_KEY=
MODEL_NAME=qwen/qwen3.8-27b
# Full schema is included in the prompt and validated locally (see MODELS.md).
MODEL_RESPONSE_FORMAT=json_object
MODEL_TIMEOUT_SECONDS=300
# Set to 1 to use HTTP_PROXY/HTTPS_PROXY and certificate settings from the environment.
MODEL_TRUST_ENV=0
MODEL_REASONING_ENABLED=0
MODEL_IMAGE_MAX_EDGE=896
MODEL_MAX_SOURCE_IMAGES=4
MODEL_MAX_PLANNING_ASSETS=8
MODEL_MAX_PLANNING_CLAIMS=32
MODEL_MAX_PLANNING_CHARS=18000
MODEL_AUDIT_MODE=failures
MODEL_AUDIT_CLAIM_CHARS=900
MODEL_MAX_TOKENS_PLANNING=16000
MODEL_MAX_TOKENS_REGENERATE_SLIDE=3000
MODEL_MAX_TOKENS_VISION_AUDIT=3000
MODEL_MAX_TOKENS_IMAGE_SELECTION=3000
MODEL_CACHE=1
# Set T2I_BASE_URL to an empty value to disable image generation.
T2I_BASE_URL=https://polza.ai/api/v1
T2I_API_KEY=
T2I_MODEL=tongyi-mai/z-image
T2I_ASPECT_RATIO=16:9
# Width/height apply only to a custom OpenAI-compatible T2I endpoint.
T2I_WIDTH=1024
T2I_HEIGHT=576
T2I_TIMEOUT_SECONDS=180
FONT_FALLBACK=Arial
SOFFICE=soffice
PDFTOPPM=pdftoppm
CORS_ORIGINS=http://localhost:5173
